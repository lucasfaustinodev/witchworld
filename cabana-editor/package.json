{
  "name": "witchworld-r3f-laboratory",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "build:publish": "npm run typecheck && npm run build:game",
    "build:game": "tsc -p game/tsconfig.json && vite build --config game/vite.config.mts",
    "test:game": "node --test game/tests/*.test.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@react-three/fiber": "9.8.2",
    "@react-three/drei": "10.7.9",
    "@react-three/postprocessing": "3.2.0",
    "postprocessing": "6.39.5",
    "three": "0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "vite": "8.3.4",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@types/node": "26.6.5"
  }
}
